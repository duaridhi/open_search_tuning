# =============================================================================
# cuad-ai-demo — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env.dev` (repo root) and fill in real values. The app
# loads `.env.dev` from the repo root (see qdrant_search_hf.py / chat_hf.py /
# qdrant_cluster_connect.py / upload_to_qdrant_hf.py). NEVER commit `.env.dev`.
# =============================================================================

# --- HuggingFace -------------------------------------------------------------
# Required for the serverless Inference API (embeddings + reranker + chat) and
# for the Hub dataset that stores the source PDFs.
HF_TOKEN=your_huggingface_token_here
HF_REPO_ID=your-org/cuad-pdfs
HF_REPO_TYPE=dataset
HF_REVISION=main
# IMPORTANT: leave HF_PROVIDER unset. Setting it routes embeddings through the
# legacy raw-router path instead of the bge-large InferenceClient path.
# HF_PROVIDER=

# --- Qdrant ------------------------------------------------------------------
# Use CLUSTER_URL + QDRANT_API_KEY for Qdrant Cloud, or QDRANT_URL for self-hosted.
CLUSTER_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.qdrant.io
QDRANT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QDRANT_PORT=6333
# QDRANT_URL=http://localhost:6333

# Collection must be 1024-d (bge-large) + BM42 sparse to match the query side.
QDRANT_COLLECTION=cuad_bgelarge_hybrid

# --- Embedding (query side) --------------------------------------------------
# Production: bge-large via HF serverless. EMBED_BACKEND=hf is the default.
# Set EMBED_BACKEND=local only for the offline eval harness.
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_BACKEND=hf
# VECTOR_SIZE is used at INGEST time; must match the embedder output (bge-large=1024).
VECTOR_SIZE=1024

# --- Search strategy / model loading -----------------------------------------
# LOAD_MODEL_STRATEGY selects which query encoders load at startup, using the same
# vocabulary as the per-request `strategy`:
#   semantic_search → dense embedder only
#   sparse_search   → BM42 sparse encoder only
#   hybrid_search   → both (REQUIRED for hybrid_search AND for the matched-keyword
#                     highlighting returned on sparse/hybrid results)
# Production deploys hybrid_search. Requesting a strategy whose models were not
# loaded fails loudly rather than silently degrading to semantic.
LOAD_MODEL_STRATEGY=hybrid_search
SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions
# Legacy fallback: ENABLE_HYBRID=1 maps to hybrid_search when LOAD_MODEL_STRATEGY
# is unset. Prefer LOAD_MODEL_STRATEGY; this is kept only for back-compat.
# ENABLE_HYBRID=0

# Weighted RRF fusion for hybrid_search — only the dense:sparse ratio matters.
# Tuned on cuad_bgelarge_hybrid_50 (0.7:0.3 beats balanced); see tests/eval/RRF_WEIGHT_TUNING.md.
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3

# --- Result reranker (precision lever) ---------------------------------------
# Cross-encoder reranks a candidate pool down to top_k. RERANK_BACKEND=hf uses
# the serverless Inference API; set RERANK_BACKEND=local for the eval harness.
RERANK_BACKEND=hf
RERANK_RESULTS=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
# Pool = min(top_k * RERANK_POOL, RERANK_FETCH_LIMIT). At top_k=20, pool=5 → 100,
# capped at 60. Each pool candidate is one HF call; raise the cap for more recall.
RERANK_POOL=5
RERANK_FETCH_LIMIT=60
# Bounded concurrency for per-pair HF reranker calls (no native batch route).
RERANK_HF_WORKERS=16

# --- /search behavior --------------------------------------------------------
SEARCH_TOP_K=20
# Per-sentence highlighting is OFF by default (it adds ~20 HF calls per result).
# The result reranker already orders results; ?highlight=true overrides per-request.
SEARCH_HIGHLIGHT=false
# Fire one embed + one reranker call on startup to warm the serverless endpoints.
WARMUP_ON_START=false

# --- Chat (RAG) --------------------------------------------------------------
CHAT_MODEL=Qwen/Qwen3-235B-A22B:novita

# --- Operational tuning ------------------------------------------------------
LOG_LEVEL=INFO
INIT_QDRANT_TIMEOUT=30
INIT_HF_TIMEOUT=30
COLLECTION_STATS_TIMEOUT=15
SEARCH_TIMEOUT=60
DOCS_LIST_TIMEOUT=30
DOCS_DETAIL_TIMEOUT=30
CHAT_TIMEOUT=120
