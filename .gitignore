# Eval: per-run outputs and raw HF cache are not tracked.
# Tracked: queries.json, queries_smoke.json, gold.json, doc_scoped_titles.json,
# build_gold.py, run_eval.py, baseline/, report.md, STRATEGY.md, QUERIES.md.
tests/eval/runs/
tests/eval/cuad_gold/
tests/eval/gold/
tests/eval/rrf_cache/
# Ignore JSON anywhere under tests/ (generated eval/sweep/cache artifacts).
# Already-tracked curated files (queries*.json, gold.json, doc_scoped_titles.json)
# stay tracked; this only prevents new JSON from being committed accidentally.
tests/**/*.json
tests/eval/gold_debug.csv
